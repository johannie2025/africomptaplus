<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AfriComptaPlus" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.AfriComptaPlus.NoActionBar" parent="Theme.AfriComptaPlus">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Cards -->
    <style name="DashboardCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
    </style>

    <!-- Bouton principal -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Bouton activation (orange) -->
    <style name="ActivationButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/lock_btn</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
