<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="64sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="AfriCompta+"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Période d'évaluation Terminée"
        android:textColor="#FFCDD2"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#FFCDD2"/>

    <TextView
        android:id="@+id/tvLockReason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="Votre période d'essai de 14 jours est terminée."
        android:textColor="#FFEBEE"
        android:textSize="14sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#33FFFFFF"
        android:gravity="center"
        android:padding="16dp"
        android:text="Contactez Wise Design pour obtenir votre code d'activation et profiter de toutes les fonctionnalités en illimité."
        android:textColor="@color/white"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/btnActivate"
        style="@style/ActivationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:text="📱 Demander mon Code d'Activation"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="WhatsApp : +240 555 445 514"
        android:textColor="#FFCDD2"
        android:textSize="12sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Wise Design — AfriCompta+"
        android:textColor="#EF9A9A"
        android:textSize="11sp"/>

</LinearLayout>
