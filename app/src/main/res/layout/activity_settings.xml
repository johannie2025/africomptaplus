<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- LICENCE -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_license_section" android:textSize="14sp" android:textAllCaps="true"
            android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
        <TextView android:id="@+id/tvLicenseStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:text="@string/settings_license_checking"
            android:background="@color/white" android:textSize="14sp"
            android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etLicenseKey"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/settings_license_key_hint"
            android:inputType="textCapCharacters" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnActivateLicense"
            style="@style/PrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_license_activate" android:layout_marginBottom="24dp"/>

        <!-- BOUTIQUE -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_shop_section" android:textSize="14sp" android:textAllCaps="true"
            android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
        <EditText android:id="@+id/etShopName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/settings_shop_name_hint" android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etShopPhone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/settings_shop_phone_hint" android:inputType="phone"
            android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etShopAddress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/settings_shop_address_hint" android:layout_marginBottom="10dp"/>
        <Switch android:id="@+id/swVatEnabled"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_vat_enabled" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etVatRate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/settings_vat_rate_hint" android:inputType="numberDecimal"
            android:layout_marginBottom="10dp"/>
        <EditText android:id="@+id/etInvoiceFooter"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/settings_invoice_footer_hint" android:layout_marginBottom="16dp"/>

        <!-- LOGO -->
        <TextView android:id="@+id/tvLogoPath"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_logo_none" android:textColor="@color/text_secondary"
            android:textSize="12sp" android:padding="8dp"
            android:background="@color/white" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnPickLogo"
            style="@style/PrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_logo_pick" android:layout_marginBottom="24dp"/>

        <!-- SAUVEGARDE CLOUD (Premium) -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_cloud_section" android:textSize="14sp" android:textAllCaps="true"
            android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnCloudBackup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_cloud_backup"
            android:backgroundTint="@color/info" android:textColor="@color/white"
            android:layout_marginBottom="24dp"/>

        <!-- ENREGISTRER -->
        <Button android:id="@+id/btnSaveSettings"
            style="@style/ActivationButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/settings_save"/>
    </LinearLayout>
</ScrollView>
