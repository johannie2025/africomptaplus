<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">

    <include layout="@layout/view_topbar"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- ───────── LICENCE ───────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_blue" android:padding="10dp"
                        android:src="@drawable/ic_key" android:tint="@color/primary"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp"
                        android:text="Licence" style="@style/SectionTitle"/>
                    <TextView android:id="@+id/tvLicenseStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_warning" android:text="Vérification…"
                        android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>

                <TextView android:id="@+id/tvLicenseInfo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="@color/text_secondary"
                    android:textSize="12sp" android:visibility="gone"/>

                <TextView style="@style/FormLabel" android:layout_marginTop="14dp" android:text="Clé de licence"/>
                <EditText android:id="@+id/etLicenseKey"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="ACP-XXXX-XXXX-XXXX" android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="20"/>

                <Button android:id="@+id/btnActivateLicense" style="@style/PrimaryButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Activer la licence"/>

                <TextView android:id="@+id/tvDeviceId"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="@color/text_hint" android:textSize="11sp"/>
            </LinearLayout>

            <!-- ───────── IDENTITÉ BOUTIQUE ───────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_card">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_orange" android:padding="10dp"
                        android:src="@drawable/ic_store" android:tint="@color/accent"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:text="Identité de la boutique"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Affichée sur vos factures et rapports PDF"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Logo -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivLogoPreview"
                        android:layout_width="84dp" android:layout_height="84dp"
                        android:background="@drawable/bg_dashed_box" android:padding="10dp"
                        android:src="@drawable/ic_image" android:tint="@color/text_hint"
                        android:scaleType="fitCenter" android:contentDescription="Logo"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:id="@+id/tvLogoPath"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Aucun logo" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <Button android:id="@+id/btnPickLogo" style="@style/OutlineButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:minHeight="44dp"
                            android:text="Choisir un logo" android:textSize="13sp"/>
                        <TextView android:id="@+id/btnRemoveLogo"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:padding="4dp" android:text="Retirer le logo"
                            android:textColor="@color/error" android:textSize="12sp" android:textStyle="bold"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/FormLabel" android:layout_marginTop="16dp" android:text="Nom de la boutique *"/>
                <EditText android:id="@+id/etShopName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Ex : Boutique Mama Awa" android:inputType="textCapWords"/>

                <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="Activité / slogan"/>
                <EditText android:id="@+id/etShopTagline" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Ex : Vente de matériel électronique" android:inputType="textCapSentences"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                        <TextView style="@style/FormLabel" android:text="Téléphone"/>
                        <EditText android:id="@+id/etShopPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="+240 …" android:inputType="phone"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                        <TextView style="@style/FormLabel" android:text="Email"/>
                        <EditText android:id="@+id/etShopEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="contact@…" android:inputType="textEmailAddress"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="Adresse / localisation"/>
                <EditText android:id="@+id/etShopAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Quartier, ville, pays" android:inputType="textCapSentences"/>

                <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="N° fiscal / RCCM (optionnel)"/>
                <EditText android:id="@+id/etShopTaxId" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="NIF, RCCM…" android:inputType="textCapCharacters"/>

                <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="Message de pied de page"/>
                <EditText android:id="@+id/etInvoiceFooter" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Merci pour votre achat !" android:inputType="textCapSentences"/>

                <Button android:id="@+id/btnPreviewInvoice" style="@style/OutlineButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="Aperçu de la facture"/>

                <Button android:id="@+id/btnSaveSettings" style="@style/ActivationButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Enregistrer"/>
            </LinearLayout>

            <!-- ───────── TVA ───────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_green" android:padding="10dp"
                        android:src="@drawable/ic_receipt" android:tint="@color/success"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:text="TVA"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ajoutée aux prix de vente (HT)"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swTva" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/boxTvaRate" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/FormLabel" android:layout_marginTop="14dp" android:text="Taux de TVA (%)"/>
                    <EditText android:id="@+id/etTvaRate" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Ex : 18" android:inputType="numberDecimal" android:maxLength="6"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:textColor="@color/text_hint" android:textSize="11sp"
                        android:text="Appliquée aux nouvelles ventes. Le CA des rapports est calculé hors taxes."/>
                </LinearLayout>
                <Button android:id="@+id/btnSaveTva" style="@style/PrimaryButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="Enregistrer la TVA"/>
            </LinearLayout>

            <!-- ───────── SAUVEGARDE ───────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_violet" android:padding="10dp"
                        android:src="@drawable/ic_cloud" android:tint="@color/violet"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView style="@style/SectionTitle" android:text="Sauvegarde &amp; restauration"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Réservé aux licences actives" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/tvLastBackup" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>

                <Button android:id="@+id/btnDriveBackup" style="@style/PrimaryButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Sauvegarder sur Google Drive"/>
                <Button android:id="@+id/btnDriveRestore" style="@style/OutlineButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Restaurer depuis Drive"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="4dp" android:background="@color/border"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <Button android:id="@+id/btnFileExport" style="@style/OutlineButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp" android:minHeight="48dp" android:textSize="13sp" android:text="Exporter fichier"/>
                    <Button android:id="@+id/btnFileImport" style="@style/OutlineButton"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="5dp" android:minHeight="48dp" android:textSize="13sp" android:text="Importer fichier"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
