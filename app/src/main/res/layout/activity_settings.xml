<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paramètres"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gérez la licence, la boutique et le branding"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 Licence"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLicenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/settings_license_checking"
                android:textColor="@color/text_primary"
                android:background="#F1F5F9"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etLicenseKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_license_key_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnActivateLicense"
                style="@style/ActivationButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_license_activate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏪 Boutique"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etShopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_shop_name_hint"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etShopPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_shop_phone_hint"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etShopAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_shop_address_hint"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <Switch
                android:id="@+id/swVatEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_vat_enabled"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etVatRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_vat_rate_hint"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etInvoiceFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_invoice_footer_hint"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvLogoPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_logo_none"
                android:textColor="@color/text_secondary"
                android:padding="12dp"
                android:background="#F8FAFC"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnPickLogo"
                style="@style/PremiumButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_logo_pick"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnCloudBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_cloud_backup"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@color/info"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnSaveSettings"
                style="@style/ActivationButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
