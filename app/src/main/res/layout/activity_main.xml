<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_header_flat" android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="36dp" android:paddingBottom="76dp">

                <ImageView android:id="@+id/ivShopLogo"
                    android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/bg_logo_round" android:padding="8dp"
                    android:src="@drawable/ic_store" android:tint="@color/primary"
                    android:scaleType="fitCenter" android:contentDescription="Logo boutique"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Bonjour," android:textColor="#B9C7F0" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvShopName"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AfriCompta+" android:textColor="@color/white"
                        android:textSize="21sp" android:textStyle="bold" android:singleLine="true"
                        android:ellipsize="end"/>
                    <TextView android:id="@+id/tvTrialBadge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:background="@drawable/bg_glass"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:text="" android:textColor="@color/white" android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ImageView android:id="@+id/btnSettings"
                    android:layout_width="46dp" android:layout_height="46dp"
                    android:background="@drawable/bg_glass" android:padding="12dp"
                    android:src="@drawable/ic_settings" android:tint="@color/white"
                    android:contentDescription="Paramètres" android:clickable="true" android:focusable="true"/>
            </LinearLayout>

            <!-- KPI 2x2 (chevauche le header) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="-52dp"
                android:paddingStart="16dp" android:paddingEnd="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical"
                        android:background="@drawable/bg_card" android:padding="16dp" android:elevation="2dp">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp"
                            android:background="@drawable/bg_icon_blue" android:padding="9dp"
                            android:src="@drawable/ic_trending" android:tint="@color/primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="CA aujourd'hui"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvRevenueToday"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 XAF" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold" android:singleLine="true"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical"
                        android:background="@drawable/bg_card" android:padding="16dp" android:elevation="2dp">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp"
                            android:background="@drawable/bg_icon_green" android:padding="9dp"
                            android:src="@drawable/ic_receipt" android:tint="@color/success"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="Ventes du jour"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvSalesCount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical"
                        android:background="@drawable/bg_card" android:padding="16dp" android:elevation="2dp">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp"
                            android:background="@drawable/bg_icon_orange" android:padding="9dp"
                            android:src="@drawable/ic_alert" android:tint="@color/accent"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="Stock critique"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvLowStock"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/text_primary"
                            android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical"
                        android:background="@drawable/bg_card" android:padding="16dp" android:elevation="2dp">
                        <ImageView android:layout_width="38dp" android:layout_height="38dp"
                            android:background="@drawable/bg_icon_red" android:padding="9dp"
                            android:src="@drawable/ic_wallet" android:tint="@color/error"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="Dettes en cours"
                            android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        <TextView android:id="@+id/tvDebts"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0 XAF" android:textColor="@color/error"
                            android:textSize="18sp" android:textStyle="bold" android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Modules -->
            <TextView style="@style/SectionTitle" android:text="Modules"
                android:layout_marginTop="24dp" android:layout_marginStart="20dp" android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">

                <LinearLayout android:id="@+id/cardSale" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_blue"
                        android:src="@drawable/ic_cart" android:tint="@color/primary"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Nouvelle vente"/>
                        <TextView style="@style/ModuleSub" android:text="Encaisser un client"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardProducts" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_violet"
                        android:src="@drawable/ic_box" android:tint="@color/violet"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Produits &amp; Stock"/>
                        <TextView style="@style/ModuleSub" android:text="Gérer l'inventaire"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardClients" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_green"
                        android:src="@drawable/ic_users" android:tint="@color/success"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Clients"/>
                        <TextView style="@style/ModuleSub" android:text="Gérer vos clients"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardDebts" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_red"
                        android:src="@drawable/ic_wallet" android:tint="@color/error"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Suivi des dettes"/>
                        <TextView style="@style/ModuleSub" android:text="Créances et paiements"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardExpenses" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_orange"
                        android:src="@drawable/ic_cash" android:tint="@color/accent"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Dépenses"/>
                        <TextView style="@style/ModuleSub" android:text="Charges et achats"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardReports" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_blue"
                        android:src="@drawable/ic_chart" android:tint="@color/primary"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Rapports financiers"/>
                        <TextView style="@style/ModuleSub" android:text="CA, bénéfices, export PDF"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardHistory" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_violet"
                        android:src="@drawable/ic_history" android:tint="@color/violet"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Historique des ventes"/>
                        <TextView style="@style/ModuleSub" android:text="Revoir et partager les factures"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cardSettings" style="@style/ModuleRow">
                    <ImageView style="@style/ModuleIcon" android:background="@drawable/bg_icon_green"
                        android:src="@drawable/ic_store" android:tint="@color/success"/>
                    <LinearLayout style="@style/ModuleText">
                        <TextView style="@style/ModuleTitle" android:text="Ma boutique &amp; licence"/>
                        <TextView style="@style/ModuleSub" android:text="Logo, infos facture, activation"/>
                    </LinearLayout>
                    <ImageView style="@style/ModuleChevron"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="Wise Design · +240 555 445 514"
                android:textColor="@color/text_hint" android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
