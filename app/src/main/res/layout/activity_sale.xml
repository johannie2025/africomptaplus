<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">

    <!-- Client selector bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:padding="10dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:elevation="4dp">
        <TextView android:id="@+id/tvClientSelected"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Client : Client Passager"
            android:textSize="13sp" android:textColor="@color/text_primary"/>
        <Button android:id="@+id/btnSelectClient"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Changer" android:textSize="12sp"
            android:backgroundTint="@color/primary_light" android:textColor="@color/white"
            android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
    </LinearLayout>

    <!-- Panier -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCart"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="8dp" android:clipToPadding="false"/>

    <!-- Panel bas -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:elevation="8dp"
        android:orientation="vertical" android:padding="14dp">

        <Button android:id="@+id/btnAddProduct"
            style="@style/PrimaryButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="+ Ajouter un produit" android:layout_marginBottom="10dp"/>

        <!-- Mode paiement -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Mode de paiement :" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <RadioGroup android:id="@+id/rgPayment"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <RadioButton android:id="@+id/rbCash"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Espèces" android:checked="true" android:textSize="12sp"/>
            <RadioButton android:id="@+id/rbMobileMoney"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Mobile Money" android:textSize="12sp"/>
            <RadioButton android:id="@+id/rbCredit"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Crédit" android:textSize="12sp"/>
        </RadioGroup>

        <!-- Date échéance (visible uniquement si Crédit) -->
        <EditText android:id="@+id/etDueDate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Date échéance crédit (YYYY-MM-DD)"
            android:inputType="date" android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- Total -->
        <TextView android:id="@+id/tvTotal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="TOTAL : 0 XAF" android:textColor="@color/primary"
            android:textSize="20sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/btnFinalizeSale"
            style="@style/ActivationButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✅ Finaliser la Vente &amp; Générer Facture"/>
    </LinearLayout>
</LinearLayout>
