<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">

    <!-- Client selector bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:padding="10dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:elevation="4dp">
        <TextView android:id="@+id/tvClientSelected"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/sale_client_label"
            android:textSize="13sp" android:textColor="@color/text_primary"/>
        <Button android:id="@+id/btnSelectClient"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/sale_change_client" android:textSize="12sp"
            android:backgroundTint="@color/primary_light" android:textColor="@color/white"
            android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
    </LinearLayout>

    <!-- Panier -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCart"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="8dp" android:clipToPadding="false"/>

    <!-- Panel bas -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" android:elevation="8dp"
        android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnScanBarcode"
                style="@style/PrimaryButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_scan" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnAddProduct"
                style="@style/PrimaryButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_add" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnHoldSale"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_hold"
                android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/btnResumeSale"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_resume"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Mode paiement -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/sale_payment_label" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
        <RadioGroup android:id="@+id/rgPayment"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <RadioButton android:id="@+id/rbCash"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_cash" android:checked="true" android:textSize="12sp"/>
            <RadioButton android:id="@+id/rbMobileMoney"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_mobile_money" android:textSize="12sp"/>
            <RadioButton android:id="@+id/rbCredit"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_credit" android:textSize="12sp"/>
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/sale_discount_label" android:textSize="13sp"
                android:textColor="@color/text_secondary"/>
            <RadioGroup android:id="@+id/rgDiscountType"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbDiscountPercent"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="%" android:checked="true"/>
                <RadioButton android:id="@+id/rbDiscountAmount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="XAF"/>
            </RadioGroup>
        </LinearLayout>
        <EditText android:id="@+id/etDiscountValue"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/sale_discount_value_hint" android:inputType="numberDecimal"
            android:layout_marginBottom="6dp"/>

        <!-- Date échéance (visible uniquement si Crédit) -->
        <EditText android:id="@+id/etDueDate"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/sale_due_date_hint"
            android:inputType="date" android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvSubtotal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sale_subtotal" android:textSize="12sp"
            android:textColor="@color/text_secondary"/>
        <TextView android:id="@+id/tvDiscountAmount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sale_discount_summary" android:textSize="12sp"
            android:textColor="@color/text_secondary"/>
        <TextView android:id="@+id/tvVatAmount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sale_vat_disabled" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>

        <!-- Total -->
        <TextView android:id="@+id/tvTotal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sale_total_label" android:textColor="@color/primary"
            android:textSize="20sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/btnFinalizeSale"
            style="@style/ActivationButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/sale_finalize_btn"/>
    </LinearLayout>
</LinearLayout>
