<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <include layout="@layout/view_topbar"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvPurSupplier" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="14dp" android:background="@drawable/bg_card"
                android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
            <LinearLayout android:id="@+id/btnAddLine" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="12dp" android:gravity="center" android:background="@drawable/bg_card"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="+ Ajouter un produit" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/llLines" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical"/>
            <TextView android:id="@+id/tvPurTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="end" android:text="Total : 0"
                android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
            <TextView style="@style/FormLabel" android:layout_marginTop="12dp" android:text="Montant payé maintenant"/>
            <EditText android:id="@+id/etPurPaid" style="@style/AppEditText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:hint="0 = tout à crédit"/>
            <RadioGroup android:id="@+id/rgPurMethod" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/rbPurCash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Espèces"/>
                <RadioButton android:id="@+id/rbPurMobile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Mobile Money"/>
            </RadioGroup>
            <TextView android:id="@+id/tvPurRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"/>
            <CheckBox android:id="@+id/cbUpdateCost" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:checked="true" android:text="Mettre à jour le prix d'achat des produits"/>
            <TextView style="@style/FormLabel" android:layout_marginTop="8dp" android:text="Note (facultatif)"/>
            <EditText android:id="@+id/etPurNotes" style="@style/AppEditText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapSentences" android:hint="N° de bon de livraison, remarque…"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/btnSavePurchase" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_margin="16dp" android:gravity="center" android:background="@drawable/bg_btn_cta"
        android:elevation="6dp" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Enregistrer l'achat" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
