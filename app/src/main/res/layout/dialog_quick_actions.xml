<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:background="@color/white">

    <TextView style="@style/SectionTitle" android:text="Actions rapides" android:layout_marginBottom="14dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:id="@+id/qaSale" style="@style/QuickAction" android:layout_marginEnd="5dp">
            <ImageView style="@style/QuickIcon" android:background="@drawable/bg_icon_orange" android:src="@drawable/ic_cart" android:tint="@color/accent"/>
            <TextView style="@style/QuickLabel" android:text="Nouvelle vente"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/qaProduct" style="@style/QuickAction" android:layout_marginStart="5dp" android:layout_marginEnd="5dp">
            <ImageView style="@style/QuickIcon" android:background="@drawable/bg_icon_violet" android:src="@drawable/ic_box" android:tint="@color/violet"/>
            <TextView style="@style/QuickLabel" android:text="Nouveau produit"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/qaExpense" style="@style/QuickAction" android:layout_marginStart="5dp">
            <ImageView style="@style/QuickIcon" android:background="@drawable/bg_icon_red" android:src="@drawable/ic_cash" android:tint="@color/error"/>
            <TextView style="@style/QuickLabel" android:text="Nouvelle dépense"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/qaHome" style="@style/QuickAction" android:layout_marginEnd="5dp">
            <ImageView style="@style/QuickIcon" android:background="@drawable/bg_icon_blue" android:src="@drawable/ic_home" android:tint="@color/primary"/>
            <TextView style="@style/QuickLabel" android:text="Accueil"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/qaHistory" style="@style/QuickAction" android:layout_marginStart="5dp" android:layout_marginEnd="5dp">
            <ImageView style="@style/QuickIcon" android:background="@drawable/bg_icon_blue" android:src="@drawable/ic_history" android:tint="@color/primary"/>
            <TextView style="@style/QuickLabel" android:text="Historique"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/qaSettings" style="@style/QuickAction" android:layout_marginStart="5dp">
            <ImageView style="@style/QuickIcon" android:background="@drawable/bg_icon_green" android:src="@drawable/ic_store" android:tint="@color/success"/>
            <TextView style="@style/QuickLabel" android:text="Ma boutique"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
